{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://raw.githubusercontent.com/savvy-web/silk-sync-action/main/silk.config.schema.json",
	"$ref": "#/$defs/SilkConfig",
	"$defs": {
		"LabelDefinition": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1,
					"maxLength": 50,
					"description": "Label name (case-insensitive matching)"
				},
				"description": {
					"type": "string",
					"maxLength": 100,
					"description": "Short label description"
				},
				"color": {
					"type": "string",
					"pattern": "^[0-9a-fA-F]{6}$",
					"description": "Hex color without # prefix"
				}
			},
			"required": [
				"name",
				"description",
				"color"
			],
			"additionalProperties": false,
			"title": "Label Definition"
		},
		"OptionalBoolean": {
			"anyOf": [
				{
					"type": "boolean"
				},
				{
					"type": "null"
				}
			]
		},
		"RepositorySettings": {
			"type": "object",
			"properties": {
				"has_wiki": {
					"$ref": "#/$defs/OptionalBoolean"
				},
				"has_issues": {
					"$ref": "#/$defs/OptionalBoolean"
				},
				"has_projects": {
					"$ref": "#/$defs/OptionalBoolean"
				},
				"has_discussions": {
					"$ref": "#/$defs/OptionalBoolean"
				},
				"allow_merge_commit": {
					"$ref": "#/$defs/OptionalBoolean"
				},
				"allow_squash_merge": {
					"$ref": "#/$defs/OptionalBoolean"
				},
				"squash_merge_commit_title": {
					"anyOf": [
						{
							"type": "string",
							"enum": [
								"PR_TITLE",
								"COMMIT_OR_PR_TITLE"
							]
						},
						{
							"type": "null"
						}
					]
				},
				"squash_merge_commit_message": {
					"anyOf": [
						{
							"type": "string",
							"enum": [
								"PR_BODY",
								"COMMIT_MESSAGES",
								"BLANK"
							]
						},
						{
							"type": "null"
						}
					]
				},
				"allow_rebase_merge": {
					"$ref": "#/$defs/OptionalBoolean"
				},
				"allow_update_branch": {
					"$ref": "#/$defs/OptionalBoolean"
				},
				"delete_branch_on_merge": {
					"$ref": "#/$defs/OptionalBoolean"
				},
				"web_commit_signoff_required": {
					"$ref": "#/$defs/OptionalBoolean"
				},
				"allow_auto_merge": {
					"$ref": "#/$defs/OptionalBoolean"
				}
			},
			"additionalProperties": false,
			"title": "Repository Settings",
			"description": "Repository settings to enforce"
		},
		"SilkConfig": {
			"type": "object",
			"properties": {
				"$schema": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					],
					"description": "Path to the JSON schema file"
				},
				"labels": {
					"type": "array",
					"description": "Labels to sync across repositories",
					"items": {
						"$ref": "#/$defs/LabelDefinition"
					}
				},
				"settings": {
					"$ref": "#/$defs/RepositorySettings"
				}
			},
			"required": [
				"labels",
				"settings"
			],
			"additionalProperties": false,
			"title": "Silk Sync Configuration",
			"description": "Configuration for the silk-sync workflow that standardizes repository labels and settings across the organization."
		}
	}
}
